PORT=4000
NODE_ENV=development
# Leave DATABASE_URL empty in development to use the embedded Postgres (PGlite, stored in PGLITE_DIR).
# In production, set DATABASE_URL to your pooled Neon connection string (-pooler host, sslmode=require).
DATABASE_URL=
# Optional unpooled Neon connection string (no -pooler host) used by `npm run migrate` CLI.
DIRECT_DATABASE_URL=
PGLITE_DIR=./data/pgdata
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated frontend origins (e.g. https://crm.yourdomain.com,http://localhost:5173)
CORS_ORIGIN=http://localhost:5173
# Cookie SameSite policy: 'lax' for local dev / same-site domains, 'none' for cross-origin HTTPS (Vercel + Render)
COOKIE_SAME_SITE=lax
# Optional cookie domain when frontend & API share a parent domain (e.g. .yourdomain.com)
COOKIE_DOMAIN=
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
MAX_VIDEO_UPLOAD_MB=100
SEED_ADMIN_PASSWORD=app@123

# Cloudinary media and video storage (leave blank to store on local disk only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=brightlook-crm
